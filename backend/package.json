{
  "name": "conectatutor-api",
  "private": true,
  "version": "1.0.0",
  "description": "API REST de ConectaTutor Uniguajira: tutorías entre estudiantes con oferta verificada.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node src/scripts/seed.js",
    "test": "node --test --test-concurrency=1 \"pruebas/**/*.test.js\""
  },
  "config": {
    "mongodbMemoryServer": {
      "downloadDir": ".cache/mongodb-binaries"
    }
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1",
    "nodemailer": "~10.3.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.2"
  }
}
