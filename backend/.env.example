# ─────────────────────────────────────────────────────────────
# Variables de entorno del BACKEND
# 1. Copia este archivo como .env   (cp .env.example .env)
# 2. Ajusta los valores. El archivo .env NUNCA se sube a Git.
# ─────────────────────────────────────────────────────────────

# Entorno: development | test | production
NODE_ENV=development

# Puerto donde escucha la API
PORT=3000

# Cadena de conexión a MongoDB.
# - Atlas (reemplaza USUARIO, CLAVE y CLUSTER con tus datos):
#   MONGODB_URI=mongodb+srv://USUARIO:CLAVE@CLUSTER.mongodb.net/conectatutor?retryWrites=true&w=majority
# - MongoDB instalado en el computador:
#   MONGODB_URI=mongodb://127.0.0.1:27017/conectatutor
# Si se deja vacía en desarrollo, la API arranca con una base temporal en memoria
# (los datos se pierden al apagarla) y carga los datos de demostración.
# En producción es obligatoria.
MONGODB_URI=

# Origen(es) del frontend autorizados por CORS (separa varios con coma)
CORS_ORIGIN=http://localhost:5173

# Contraseña de las cuentas de demostración que crea `npm run seed`.
# Mínimo 8 caracteres, con letras y números. Cámbiala antes de desplegar.
CLAVE_DEMO=CambiaEstaClave1
